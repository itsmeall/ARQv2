{
  "name": "Tenant",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "code": {
      "type": "string"
    },
    "owner_name": {
      "type": "string"
    },
    "contact_phone": {
      "type": "string"
    },
    "contact_email": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "currency": {
      "type": "string",
      "default": "IDR"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "trial",
        "suspended"
      ],
      "default": "active"
    },
    "plan": {
      "type": "string",
      "enum": [
        "starter",
        "business",
        "enterprise"
      ],
      "default": "business"
    },
    "commission_enabled": {
      "type": "boolean",
      "default": true
    },
    "default_commission_rate": {
      "type": "number",
      "default": 10
    },
    "hotspot_portal_url": {
      "type": "string"
    },
    "hotspot_dns_name": {
      "type": "string"
    },
    "default_voucher_expiry_hours": {
      "type": "number",
      "default": 24
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "code"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "$or": [
        {
          "id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}