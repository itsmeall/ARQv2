{
  "name": "StockMutation",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string"
    },
    "reseller_id": {
      "type": "string"
    },
    "reseller_name": {
      "type": "string"
    },
    "package_id": {
      "type": "string"
    },
    "package_name": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "allocation",
        "sale",
        "return",
        "void"
      ]
    },
    "quantity": {
      "type": "number"
    },
    "unit_price": {
      "type": "number"
    },
    "amount": {
      "type": "number"
    },
    "actor_name": {
      "type": "string"
    },
    "note": {
      "type": "string"
    }
  },
  "required": [
    "tenant_id",
    "reseller_id",
    "type",
    "quantity"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$and": [
        {
          "data.tenant_id": {
            "$ne": null
          }
        },
        {
          "$or": [
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        }
      ]
    },
    "update": {
      "$and": [
        {
          "data.tenant_id": {
            "$ne": null
          }
        },
        {
          "$or": [
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "data.tenant_id": {
            "$ne": null
          }
        },
        {
          "$or": [
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        }
      ]
    }
  }
}