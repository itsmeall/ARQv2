{
  "name": "Voucher",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string"
    },
    "batch_id": {
      "type": "string"
    },
    "package_id": {
      "type": "string"
    },
    "package_name": {
      "type": "string"
    },
    "code": {
      "type": "string"
    },
    "price": {
      "type": "number"
    },
    "cost": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "available",
        "allocated",
        "sold",
        "void"
      ],
      "default": "available"
    },
    "reseller_id": {
      "type": "string"
    },
    "reseller_name": {
      "type": "string"
    },
    "sold_price": {
      "type": "number"
    },
    "commission_amount": {
      "type": "number"
    },
    "sold_date": {
      "type": "string"
    },
    "expiry_date": {
      "type": "string"
    },
    "note": {
      "type": "string"
    }
  },
  "required": [
    "tenant_id",
    "code",
    "package_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$and": [
        {
          "data.tenant_id": {
            "$ne": null
          }
        },
        {
          "$or": [
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        }
      ]
    },
    "update": {
      "$and": [
        {
          "data.tenant_id": {
            "$ne": null
          }
        },
        {
          "$or": [
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "data.tenant_id": {
            "$ne": null
          }
        },
        {
          "$or": [
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        }
      ]
    }
  }
}